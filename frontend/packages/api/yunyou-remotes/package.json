{
  "name": "@deepseek-ai/dsh-yunyou-remotes",
  "description": "web.v1 yunyou/{team,tasks,schedule} 域 Typert FaceModel（形状声明面；Rust 网关桥接实现）",
  "version": "0.2.2-rc.2",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/api/yunyou-remotes" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {},
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:~" },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/typert.host.js", "lib/typert.host.d.ts",
    "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts", "lib/typert.remote-client.d.ts.map",
    "lib/types/**/*.js", "lib/types/**/*.d.ts", "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map", "src"
  ]
}
