{
  "name": "@yunyou/web-workspace",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:web && pnpm run build:boot",
    "build:client": "tsdown --config-loader native --env.DSH_BUILD_FACE client",
    "build:web": "pnpm --filter @deepseek-ai/dsh-web-frontend run build",
    "build:boot": "tsx scripts/build-yunyou-boot.ts"
  },
  "devDependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "lightningcss": "^1.33.0",
    "playwright-core": "^1.65.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}